{
  "name": "dolores",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres-backed agent memory — self-hosted, local embeddings, optional API extraction.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "bench": "DOLORES_MODEL_CACHE=packages/core/.dolores-models node_modules/.bin/tsx benchmarks/run.ts",
    "bench:extraction": "node_modules/.bin/tsx benchmarks/extraction-eval.ts",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "onnxruntime-node"
    ],
    "overrides": {
      "fast-uri": "^3.1.9",
      "@hono/node-server": "^2.1.3",
      "hono": "^4.13.11",
      "find-my-way": "^9.7.0",
      "ip-address": "^10.7.4",
      "qs": "^6.16.1",
      "proxy-addr": "^2.0.8",
      "body-parser": "^2.4.0",
      "deepmerge-ts": "^8.0.2",
      "onnxruntime-node>tar": "^7.5.21"
    }
  }
}
